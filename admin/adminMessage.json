'use strict';

const fs = require('fs');
const path = require('path');
const database = require('../Script/database/database');
const { getUptimeMs, formatDuration } = require('../utils/uptime');

const CONFIG_PATH = path.join(__dirname, 'adminConfig.json');

const FALLBACK = {
  botName: 'SALIM CHAT BOT',
  ownerName: 'Salim Ahmad',
  developer: 'Salim Ahmad',
  version: '1.0.0',
  platform: 'Simulator (test mode)',
  footer: 'Developed by Salim Ahmad'
};

function readConfig() {
  try {
    const parsed = JSON.parse(fs.readFileSync(CONFIG_PATH, 'utf8'));
    return { ...FALLBACK, ...parsed };
  } catch (error) {
    return { ...FALLBACK };
  }
}

// ড্যাশবোর্ডে নাম বদলানো থাকলে (ডিফল্ট থেকে আলাদা হলে) সেটা আগে, নইলে adminConfig.json এর মান
function getAdminInfo() {
  const config = readConfig();
  const defaults = database.DEFAULT_SETTINGS;
  const botSetting = database.getSetting('bot_name', defaults.bot_name);
  const ownerSetting = database.getSetting('owner_name', defaults.owner_name);
  return {
    ...config,
    botName: botSetting !== defaults.bot_name ? botSetting : config.botName,
    ownerName: ownerSetting !== defaults.owner_name ? ownerSetting : config.ownerName,
    prefix: database.getSetting('prefix', defaults.prefix),
    maintenance: database.getSetting('maintenance_mode', 'off') === 'on'
  };
}

function buildAdminMessage() {
  const info = getAdminInfo();
  const statusIcon = info.maintenance ? '🟠' : '🟢';
  const statusText = info.maintenance ? 'MAINTENANCE' : 'ONLINE';
  return [
    `╭━━━〔 ${info.botName} 〕━━━╮`,
    '┃',
    `┃ 👑 Owner: ${info.ownerName}`,
    `┃ 🤖 Bot: ${info.botName}`,
    `┃ ⚙️ Version: ${info.version}`,
    `┃ ${statusIcon} Status: ${statusText}`,
    `┃ ⏱️ Uptime: ${formatDuration(getUptimeMs())}`,
    `┃ 💬 Prefix: ${info.prefix}`,
    `┃ 🌐 Platform: ${info.platform}`,
    '┃',
    '╰━━━━━━━━━━━━━━━━━━━━━━╯',
    '',
    `   ${info.footer}`
  ].join('\n');
}

module.exports = { getAdminInfo, buildAdminMessage, CONFIG_PATH };
